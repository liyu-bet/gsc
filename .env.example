# App
APP_URL=https://gsc.example.com
APP_NAME=GSC — портфельная панель
SESSION_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-to-64-hex-characters

# Admin access to the app itself
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Database (пароль должен совпадать с POSTGRES_PASSWORD)
POSTGRES_PASSWORD=gscpassword
DATABASE_URL=postgresql://gsc:gscpassword@postgres:5432/gsc_dashboard?schema=public

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://gsc.example.com/api/google/callback
GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/webmasters

# Read-only machine-to-machine API for The Life of Websites (LOW)
# Server-only — never use NEXT_PUBLIC_ and never commit the real token
GSC_LOW_API_TOKEN=replace-with-a-long-random-token

# Lifecycle earliest-date search (Search Analytics API lookback)
GSC_LIFECYCLE_LOOKBACK_DAYS=488
GSC_LIFECYCLE_WINDOW_DAYS=90
GSC_LIFECYCLE_TIMEOUT_MS=60000
